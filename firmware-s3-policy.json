{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFirmwareArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::firmware-demo-artifacts"
    },
    {
      "Sid": "ReadAndUploadFirmwareArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::firmware-demo-artifacts/*"
    }
  ]
}
